// The general properties of a loco (B-05): its volume, where its sounds
// play (N-05) and its picture, a crop of any image chosen like a profile
// picture by dragging and zooming.

import { Button, LineEdit, ListView, Slider } from "std-widgets.slint";

// Where the sounds of a loco play (N-05): an output device of an instance;
// empty is the host or its default device.
export struct AudioTarget {
    instance: string,
    device: string,
}

export component LocoDialog inherits Rectangle {
    in property <string> name;
    in property <image> picture;
    in property <float> volume;
    in property <[AudioTarget]> audio-targets;
    // Where the sounds of the loco play.
    in-out property <AudioTarget> audio-target;
    callback load(string) -> image;
    // The crop in pixels of the image: left, top, width.
    callback save-picture(string, float, float, float);
    callback set-volume(float);
    callback set-audio-target(AudioTarget);
    callback close();

    property <image> source;
    property <bool> loaded: source.width > 0;
    property <string> path;
    property <bool> failed;
    // The largest crop; the zoom divides it.
    property <float> largest-width: min(source.width, source.height * frame.width / frame.height);
    property <float> zoom: 1;
    property <float> crop-width: largest-width / zoom;
    property <float> crop-height: crop-width * frame.height / frame.width;
    // The middle of the crop in pixels of the image.
    property <float> center-x;
    property <float> center-y;
    property <float> crop-x: clamp(center-x - crop-width / 2, 0, source.width - crop-width);
    property <float> crop-y: clamp(center-y - crop-height / 2, 0, source.height - crop-height);
    // Screen pixels per pixel of the image.
    property <float> scale: frame.width / 1px / crop-width;

    background: #00000080;
    // Keeps clicks from the controllers below.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                background: #fafafa;
                border-radius: 5px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: name;
                        font-size: 18px;
                        height: 24px;
                        font-weight: 700;
                    }
                    // Fixed sizes, so the layout is the same with any font.
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        LineEdit {
                            placeholder-text: @tr("Image file (PNG or JPEG)");
                            text <=> path;
                        }
                        Button {
                            width: 80px;
                            text: @tr("Load");
                            clicked => {
                                source = root.load(path);
                                failed = !loaded;
                                zoom = 1;
                                center-x = source.width / 2;
                                center-y = source.height / 2;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        frame := Rectangle {
                            width: 440px;
                            height: 340px;
                            clip: true;
                            background: #e0e0e0;
                            if !loaded: Image {
                                source: picture;
                                width: parent.width;
                                height: parent.height;
                            }
                            if loaded: Image {
                                source: source;
                                x: -crop-x * scale * 1px;
                                y: -crop-y * scale * 1px;
                                width: source.width * scale * 1px;
                                height: source.height * scale * 1px;
                            }
                            if failed: Text {
                                text: @tr("Cannot read the image");
                                color: #690000;
                            }
                            drag := TouchArea {
                                property <float> start-x;
                                property <float> start-y;
                                mouse-cursor: loaded ? MouseCursor.move : MouseCursor.default;
                                changed pressed => {
                                    start-x = crop-x + crop-width / 2;
                                    start-y = crop-y + crop-height / 2;
                                }
                                // The middle stays where the crop can go, so it
                                // follows at once when dragged back.
                                moved => {
                                    center-x = clamp(start-x - (self.mouse-x - self.pressed-x) / 1px / scale, crop-width / 2, source.width - crop-width / 2);
                                    center-y = clamp(start-y - (self.mouse-y - self.pressed-y) / 1px / scale, crop-height / 2, source.height - crop-height / 2);
                                }
                            }
                        }
                        VerticalLayout {
                            width: 188px;
                            spacing: 4px;
                            Text {
                                text: @tr("Sound output");
                                height: 20px;
                                font-weight: 700;
                            }
                            ListView {
                                for target in audio-targets: Rectangle {
                                    height: 36px;
                                    background: target == audio-target ? #cfe0f5 : transparent;
                                    VerticalLayout {
                                        padding-left: 6px;
                                        Text {
                                            text: target.device != "" ? target.device : @tr("Default device");
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: target.instance != "" ? target.instance : @tr("Session host");
                                            color: #6c6c6c;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            audio-target = target;
                                            root.set-audio-target(target);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        Text {
                            text: @tr("Zoom");
                            vertical-alignment: center;
                            width: 80px;
                        }
                        Slider {
                            enabled: loaded;
                            minimum: 1;
                            maximum: 4;
                            value <=> zoom;
                        }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        Text {
                            text: @tr("Volume");
                            vertical-alignment: center;
                            width: 80px;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            value: volume;
                            released(volume) => {
                                root.set-volume(volume);
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        alignment: end;
                        Button {
                            width: 120px;
                            text: @tr("Save picture");
                            enabled: loaded;
                            clicked => {
                                root.save-picture(path, crop-x, crop-y, crop-width);
                                root.close();
                            }
                        }
                        Button {
                            width: 120px;
                            text: @tr("Close");
                            clicked => {
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
