{
  "name": "Electrip 2",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "GIT_AUTHOR_NAME": "Claude (Electrip-Loop)",
    "GIT_AUTHOR_EMAIL": "noreply@anthropic.com",
    "GIT_COMMITTER_NAME": "Claude (Electrip-Loop)",
    "GIT_COMMITTER_EMAIL": "noreply@anthropic.com"
  },
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "postCreateCommand": "git config --global credential.https://github.com.helper '!gh auth git-credential' && git config --global url.https://github.com/.insteadOf git@github.com:"
}
